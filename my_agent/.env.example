# Copy to .env and fill in. .env must stay out of git.

# REQUIRED outside local development. Signs session cookies AND password
# reset tokens, so a published value lets anyone forge a reset link for
# any account. Generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# Gmail account used to send password reset (and, later, daily) email.
CAMPUS_COMPASS_EMAIL=
CAMPUS_COMPASS_EMAIL_PASSWORD=

# Optional. A Google OAuth client ID is public by design; config.py ships
# a shared default so teammates can test Google Sign-In without one.
# Leave this line commented out to use that default.
# GOOGLE_CLIENT_ID=

# Optional runtime settings.
# CAMPUS_COMPASS_DEBUG=1
# CAMPUS_COMPASS_PORT=5001
# CAMPUS_COMPASS_MONTHS_AHEAD=3


# Brevo transactional email settings.
# Create an API key in Brevo and put the real value in my_agent/.env.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=campuscompass.notify@gmail.com
BREVO_SENDER_NAME=Campus Compass

# Daily event email schedule
DAILY_EMAIL_TIME=08:00
DAILY_EMAIL_TIMEZONE=America/Los_Angeles